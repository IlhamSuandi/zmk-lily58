#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 5 seconds or longer.
};

&soft_off { /delete-property/ split-peripheral-off-on-press; };

/ {
    behaviors {
        layer_1_3: layer_1_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_1_3";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 3>;

            tapping-term-ms = <1000>;
        };

        layer_2_4: layer_2_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_2_4";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 4>;

            tapping-term-ms = <1000>;
        };

        home_row: home_row {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
            hold-trigger-on-release;
        };
    };

    macros {
        warpd_x: warpd_activation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LA(LG(X)) &to 4>;

            label = "WARPD_ACTIVATION";
        };

        to_default: to_default {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to 0>;
            label = "TO_DEFAULT";
        };

        warpd_c: warpd_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(C)) &to 4>;
            label = "WARPD_X";
        };
    };

    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <52 55>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  ENTER |  | SPACE | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC     &kp N1                &kp N2            &kp N3             &kp N4              &kp N5                              &kp N6      &kp N7                   &kp N8                     &kp N9            &kp N0                    &kp GRAVE
&kp TAB     &kp Q                 &kp W             &kp E              &kp R               &kp T                               &kp Y       &kp U                    &kp I                      &kp O             &kp P                     &kp MINUS
&kp LSHIFT  &home_row LEFT_WIN A  &home_row LALT S  &home_row LCTRL D  &home_row LSHIFT F  &kp G                               &kp H       &home_row RIGHT_SHIFT J  &home_row RIGHT_CONTROL K  &home_row RALT L  &home_row RIGHT_WIN SEMI  &kp SQT
&kp LCTRL   &kp Z                 &kp X             &kp C              &kp V               &kp B       &warpd_x     &warpd_c   &kp N       &kp M                    &kp COMMA                  &kp DOT           &kp FSLH                  &kp RSHFT
                                                    &kp LALT           &kp LGUI            &layer_1_3  &kp SPACE    &kp ENTER  &layer_2_4  &kp BACKSPACE            &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp LG(GRAVE)  &kp F1           &kp F2       &kp F3                &kp F4                 &kp F5                               &kp F6        &kp F7  &kp F8  &kp F9  &kp F10    &soft_off
&kp LG(TAB)    &kp EXCLAMATION  &kp AT_SIGN  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp KP_SUBTRACT                      &kp KP_PLUS   &kp N7  &kp N8  &kp N9  &kp PIPE   &kp LBKT
&kp ESCAPE     &kp HASH         &kp DOLLAR   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE                       &kp MINUS     &kp N4  &kp N5  &kp N6  &kp TILDE  &kp GRAVE
&kp ESCAPE     &kp PERCENT      &kp CARET    &kp LBKT              &kp RBKT               &kp AMPERSAND    &trans    &trans    &kp ASTERISK  &kp N1  &kp N2  &kp N3  &kp N0     &kp PIPE
                                             &trans                &trans                 &trans           &trans    &kp BSPC  &trans        &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        multimedia {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4                    &kp PRINTSCREEN  &kp SCROLLLOCK  &trans         &trans       &trans  &trans
&trans      &trans        &kp C_VOLUME_DOWN  &kp K_MUTE        &kp C_VOL_UP  &kp C_BRI_UP                    &trans           &trans          &trans         &trans       &trans  &trans
&trans      &trans        &kp K_PREV         &kp K_PLAY_PAUSE  &kp C_NEXT    &kp C_BRI_DN                    &kp LEFT         &kp DOWN        &kp UP_ARROW   &kp RIGHT    &trans  &trans
&trans      &trans        &kp LC(X)          &kp LC(C)         &kp LC(V)     &trans        &trans    &trans  &kp INSERT       &kp C_AC_HOME   &kp PAGE_DOWN  &kp PAGE_UP  &trans  &trans
                                             &trans            &trans        &trans        &trans    &trans  &trans           &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mouse {
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans                          &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans        &trans        &trans            &trans          &trans                          &trans          &trans          &trans        &trans           &trans  &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans                          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans        &trans        &trans            &trans          &trans  &mkp LCLK    &mkp RCLK  &trans          &trans          &trans        &trans           &trans  &trans
                                    &trans            &trans          &trans  &trans       &warpd_c   &trans          &trans          &trans
            >;
        };

        original_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                             &kp N6       &kp N7  &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                              &kp Y        &kp U   &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D     &kp F     &kp G                              &kp H        &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp B        &kp SPACE    &kp DOT  &kp N        &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LEFT  &kp DOWN  &to_default  &kp SPACE    &kp RET  &to_default  &kp UP  &kp RIGHT
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
