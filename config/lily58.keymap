#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 5 seconds or longer.
};

&soft_off { /delete-property/ split-peripheral-off-on-press; };

/ {
    behaviors {
        layer_1_3: layer_1_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_1_3";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 3>;

            tapping-term-ms = <1000>;
        };

        layer_2_4: layer_2_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_2_4";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 4>;

            tapping-term-ms = <1000>;
        };

        home_row: home_row {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  ENTER |  | SPACE | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC     &kp N1                &kp N2            &kp N3             &kp N4              &kp N5                                   &kp N6      &kp N7                   &kp N8                     &kp N9            &kp N0                    &kp GRAVE
&kp TAB     &kp Q                 &kp W             &kp E              &kp R               &kp T                                    &kp Y       &kp U                    &kp I                      &kp O             &kp P                     &kp MINUS
&kp LSHIFT  &home_row LEFT_WIN A  &home_row LALT S  &home_row LCTRL D  &home_row LSHIFT F  &kp G                                    &kp H       &home_row RIGHT_SHIFT J  &home_row RIGHT_CONTROL K  &home_row RALT L  &home_row RIGHT_WIN SEMI  &kp SQT
&kp LCTRL   &kp Z                 &kp X             &kp C              &kp V               &kp B       &kp ESCAPE    &kp BACKSPACE  &kp N       &kp M                    &kp COMMA                  &kp DOT           &kp FSLH                  &kp RSHFT
                                                    &kp LEFT           &kp DOWN_ARROW      &layer_1_3  &kp SPACE     &kp ENTER      &layer_2_4  &kp UP_ARROW             &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp ESCAPE   &kp F1           &kp F2       &kp F3                &kp F4                 &kp F5                                         &kp F6        &kp F7  &kp F8  &kp F9  &kp F10    &soft_off
&sk LA(TAB)  &kp EXCLAMATION  &kp AT_SIGN  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp KP_SUBTRACT                                &kp KP_PLUS   &kp N7  &kp N8  &kp N9  &kp PIPE   &kp LBKT
&kp ESCAPE   &kp HASH         &kp DOLLAR   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE                                 &kp MINUS     &kp N4  &kp N5  &kp N6  &kp TILDE  &kp GRAVE
&kp ESCAPE   &kp PERCENT      &kp CARET    &kp LBKT              &kp RBKT               &kp AMPERSAND    &kp C_VOL_DN    &kp C_VOL_UP  &kp ASTERISK  &kp N1  &kp N2  &kp N3  &kp N0     &kp PIPE
                                           &trans                &trans                 &trans           &trans          &kp BSPC      &trans        &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &trans  &trans            &trans            &trans            &trans                    &trans  &trans            &trans            &trans            &trans  &trans
&trans  &trans  &kp LG(N7)        &kp LG(N8)        &kp LG(N9)        &trans                    &trans  &kp LC(N7)        &kp LC(N8)        &kp LC(N9)        &trans  &trans
&trans  &trans  &kp LG(NUMBER_4)  &kp LG(N5)        &kp LG(NUMBER_6)  &trans                    &trans  &kp LC(NUMBER_4)  &kp LC(N5)        &kp LC(NUMBER_6)  &trans  &trans
&trans  &trans  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &trans  &trans    &trans  &trans  &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &trans  &trans
                                  &trans            &trans            &trans  &trans    &trans  &trans  &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        warpd_activation {
            bindings = <
&trans  &trans  &trans  &trans  &trans         &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans         &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp LA(LG(X))  &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans         &trans  &trans    &trans         &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans         &trans  &trans    &kp LA(LG(C))  &trans  &trans  &trans
            >;
        };

        original_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp ESCAPE    &kp ESCAPE  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans        &trans      &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        warpd {
            if-layers = <3>;
            then-layer = <4>;
        };
    };
};
