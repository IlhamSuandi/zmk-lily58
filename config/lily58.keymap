#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&soft_off {
    hold-time-ms = <1000>; // Only turn off it the key is held for 5 seconds or longer.
};

&soft_off {
    /delete-property/ split-peripheral-off-on-press;

    hold-time-ms = <1000>;
};

/ {
    behaviors {
        layer_1_3: layer_1_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_1_3";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 3>;

            tapping-term-ms = <1000>;
        };

        layer_2_4: layer_2_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_2_4";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 4>;

            tapping-term-ms = <1000>;
        };

        holdtap: holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
            hold-trigger-on-release;
        };

        homerow_left: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <44 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 54 55 56 57 43>;
            quick-tap-ms = <175>;
        };

        homerow_right: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
            quick-tap-ms = <175>;
        };

        layer_1_revert: layer_1_revert {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_1_REVERT";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 5>;

            tapping-term-ms = <1000>;
        };

        layer_2_revert: layer_2_revert {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_2_REVERT";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 5>;

            tapping-term-ms = <1000>;
        };
    };

    macros {
        warpd_x: warpd_activation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LA(LG(X)) &to 4>;

            label = "WARPD_ACTIVATION";
        };

        to_default: to_default {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &to 0>;
            label = "TO_DEFAULT";
        };

        warpd_c: warpd_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(C)) &to 4>;
            label = "WARPD_X";
        };

        warpd_v: warpd_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(V)) &to 4>;
            label = "WARPD_V";
        };

        warpd_x_revert: warpd_x_revert {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LA(LG(X)) &to 6>;

            label = "WARPD_X_REVERT";
        };

        warpd_v_revert: warpd_x_original {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(V)) &to 6>;
            label = "WARPD_X_ORIGINAL";
        };
    };

    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <52 55>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  ENTER |  | SPACE | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC     &kp N1                    &kp N2                    &kp N3                        &kp N4                      &kp N5                                                         &kp N6           &kp N7                        &kp N8                              &kp N9                           &kp N0                         &kp BACKSLASH
&kp TAB     &kp Q                     &kp W                     &kp E                         &kp R                       &kp T                                                          &kp Y            &kp U                         &kp I                               &kp O                            &kp P                          &kp MINUS
&kp LSHIFT  &homerow_left LEFT_WIN A  &homerow_left LALT S      &homerow_left LCTRL D         &homerow_left LSHIFT F      &kp G                                                          &kp H            &homerow_right RIGHT_SHIFT J  &homerow_right RIGHT_CONTROL K      &homerow_right RALT L            &homerow_right RIGHT_WIN SEMI  &kp SQT
&kp LCTRL   &homerow_left LEFT_WIN Z  &homerow_left LEFT_ALT X  &homerow_left LEFT_CONTROL C  &homerow_left LEFT_SHIFT V  &kp B            &warpd_x                &warpd_v              &kp N            &homerow_right RIGHT_SHIFT M  &homerow_right RIGHT_CONTROL COMMA  &homerow_right RIGHT_ALT PERIOD  &homerow_right RIGHT_WIN FSLH  &kp RSHFT
                                                                &mo 3                         &kp BACKSPACE               &layer_1_revert  &holdtap ENTER SPACE    &holdtap ENTER SPACE  &layer_2_revert  &kp BACKSPACE                 &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbol_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &trans          &trans            &trans                &trans                 &trans                          &trans  &trans           &trans        &trans     &trans         &soft_off
&trans  &kp UNDERSCORE  &kp EQUAL         &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans                          &trans  &kp AMPERSAND    &kp ASTERISK  &kp TILDE  &kp PIPE       &trans
&trans  &kp MINUS       &kp PLUS          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ESCAPE                      &trans  &kp DOLLAR       &kp PERCENT   &kp CARET  &kp GRAVE      &trans
&trans  &kp LESS_THAN   &kp GREATER_THAN  &kp LBKT              &kp RBKT               &trans      &trans    &trans    &trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp BACKSLASH  &trans
                                          &to_default           &trans                 &trans      &trans    &kp BSPC  &trans  &trans           &to_default
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        number_layer {
            bindings = <
&trans  &kp F1          &kp F2          &kp F3           &kp F4  &kp F5                    &kp F6  &kp F7        &kp F8       &kp F9  &kp F10  &trans
&trans  &trans          &kp UP_ARROW    &trans           &trans  &trans                    &trans  &kp N7        &kp N8       &kp N9  &trans   &trans
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans                    &trans  &kp N4        &kp N5       &kp N6  &trans   &trans
&trans  &trans          &trans          &trans           &trans  &trans  &trans    &trans  &trans  &kp NUMBER_1  &kp N2       &kp N3  &kp N0   &trans
                                        &to_default      &trans  &trans  &trans    &trans  &trans  &trans        &to_default
            >;
        };

        multimedia {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &trans  &trans          &trans            &trans      &trans                                                &kp INS  &kp C_AC_HOME    &kp DELETE   &kp PAGE_DOWN      &kp PAGE_UP  &kp PRINTSCREEN
&trans  &trans  &trans          &trans            &trans      &trans                                                &trans   &trans           &trans       &trans             &trans       &trans
&trans  &trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans                                                &trans   &kp C_VOLUME_UP  &kp K_MUTE   &kp C_VOLUME_DOWN  &trans       &trans
&trans  &trans  &trans          &trans            &trans      &trans  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC  &trans   &trans           &trans       &trans             &trans       &trans
                                &to_default       &trans      &trans  &to 5                   &trans                &trans   &trans           &to_default
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        original_layer {
            bindings = <
&to_default  &kp N1  &kp N2  &kp N3       &kp N4      &kp N5                          &kp N6  &kp N7         &kp N8       &kp N9   &kp N0    &kp GRAVE
&kp TAB      &kp Q   &kp W   &kp E        &kp R       &kp T                           &kp Y   &kp U          &kp I        &kp O    &kp P     &kp MINUS
&kp LSHFT    &kp A   &kp S   &kp D        &kp F       &kp G                           &kp H   &kp J          &kp K        &kp L    &kp SEMI  &kp SQT
&kp LCTRL    &kp Z   &kp X   &kp C        &kp V       &kp B   &kp DOT      &kp DOT    &kp N   &kp M          &kp COMMA    &kp DOT  &kp FSLH  &kp RSHFT
                             &to_default  &kp ESCAPE  &mo 6   &kp SPACE    &kp SPACE  &mo 6   &kp BACKSPACE  &to_default
            >;
        };

        revert-default {
            bindings = <
&kp ESC    &kp N0                             &kp N9                        &kp N8                              &kp N7                        &kp N6                                           &kp N5       &kp N4                      &kp N3                        &kp N2                    &kp N1                     &kp ESC
&kp TAB    &kp P                              &kp O                         &kp I                               &kp U                         &kp Y                                            &kp T        &kp R                       &kp E                         &kp W                     &kp Q                      &kp TAB
&kp LSHFT  &homerow_right LEFT_WIN SEMICOLON  &homerow_right RIGHT_ALT L    &homerow_right RIGHT_CONTROL K      &homerow_right RIGHT_SHIFT J  &kp H                                            &kp G        &homerow_left LSHFT F       &homerow_left LEFT_CONTROL D  &homerow_left LEFT_ALT S  &homerow_left RIGHT_WIN A  &kp LSHFT
&kp LCTRL  &homerow_right RIGHT_WIN FSLH      &homerow_right RIGHT_ALT DOT  &homerow_right RIGHT_CONTROL COMMA  &homerow_right RIGHT_SHIFT M  &kp N        &warpd_x_revert    &warpd_x_revert  &kp B        &homerow_left LEFT_SHIFT V  &homerow_left LEFT_CONTROL C  &homerow_left LEFT_ALT X  &homerow_left LEFT_WIN Z   &kp LCTRL
                                                                            &to_default                         &kp BSPC                      &to_default  &kp SPACE          &kp SPACE        &to_default  &kp BSPC                    &to_default
            >;
        };

        revert_original {
            bindings = <
&kp ESC    &kp N0         &kp N9   &kp N8       &kp N7    &kp N6                          &kp N5  &kp N4    &kp N3       &kp N2  &kp N1  &kp ESC
&kp TAB    &kp P          &kp O    &kp I        &kp U     &kp Y                           &kp T   &kp R     &kp E        &kp W   &kp Q   &kp TAB
&kp LSHFT  &kp SEMICOLON  &kp L    &kp K        &kp J     &kp H                           &kp G   &kp F     &kp D        &kp S   &kp A   &kp LSHFT
&kp LCTRL  &kp FSLH       &kp DOT  &kp COMMA    &kp M     &kp N   &to 0        &to 0      &kp B   &kp V     &kp C        &kp X   &kp Z   &kp LCTRL
                                   &to_default  &kp BSPC  &trans  &kp SPACE    &kp SPACE  &trans  &kp BSPC  &to_default
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
